VITE_BASE=/

# 正式接口服务地址，浏览器直接请求，无需 Nginx 接口转发
VITE_GLOB_API_URL=https://qq.i4.cn

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# 生产环境关闭开发调试工具
VITE_DEVTOOLS=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
