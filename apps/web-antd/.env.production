VITE_BASE=/

# 接口地址
# 认证和系统管理使用同源代理，避免跨域预检被认证服务拒绝
VITE_GLOB_API_URL=/api

# 配置管理、客户端壳开关接口地址（直接访问业务服务，不带代理前缀）
VITE_CONFIG_API_URL=http://192.168.5.197:8080

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
