{
  "paths": {
    "/admin-api/flycowerp/aiImageResult/save": {
      "post": {
        "tags": [
          "管理后台 - AI 图片生成结果"
        ],
        "summary": "上传本地图片",
        "operationId": "AiImageResult_save",
        "parameters": [
          {
            "name": "tenant-id",
            "in": "header",
            "description": "租户编号",
            "schema": {
              "type": "integer",
              "description": "租户编号",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "认证 Token",
            "schema": {
              "type": "string",
              "description": "认证 Token",
              "default": "Bearer test1"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AiImageResultSaveReqVO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResultObject"
                }
              }
            }
          }
        }
      }
    },
