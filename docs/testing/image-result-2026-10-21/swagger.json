            "description": "流程任务key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "imgId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "tenant-id",
            "in": "header",
            "description": "租户编号",
            "schema": {
              "type": "integer",
              "description": "租户编号",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "description": "认证 Token",
            "schema": {
              "type": "string",
              "description": "认证 Token",
