    "/admin-api/flycowerp/aiImageResult/delete/{id}": {
      "get": {
        "tags": [
          "管理后台 - AI 图片生成结果"
        ],
        "summary": "删除AI图片结果",
        "operationId": "AiImageResult_delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "记录ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "tenant-id",
            "in": "header",
            "description": "租户编号",
