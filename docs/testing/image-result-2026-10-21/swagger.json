  },
  "schemas": {
    "AiImageResultSaveReqVO": {
      "type": "object",
      "properties": {
        "originalUrl": {
          "type": "string",
          "description": "原图地址",
          "example": "1"
        },
        "previewUrl": {
          "type": "string",
          "description": "预览图地址",
          "example": "1"
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "缩略图地址",
          "example": "1"
        },
        "creator": {
          "type": "integer",
          "description": "创建人",
          "format": "int32",
          "example": 1
        },
        "updater": {
          "type": "integer",
          "description": "更新人",
          "format": "int32",
          "example": 1
        },
        "businessKey": {
          "type": "string",
          "description": "流程任务key",
          "example": "1"
        }
      },
      "description": "管理后台 - AI生成图片上传本地图 Request VO"
    },
    "AiImgResultRespVO": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "id",
          "format": "int32",
          "example": 1
        },
        "originalUrl": {
          "type": "string",
          "description": "原图片地址",
          "example": "image.jpg"
        },
        "previewUrl": {
          "type": "string",
          "description": "预览图地址",
          "example": "image.jpg"
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "缩略图地址",
          "example": "thumbnail.jpg"
        },
        "isAiCreate": {
          "type": "integer",
          "description": "是否AI生成 0.否 1.是",
          "format": "int32",
          "example": 0
        }
      },
      "description": "三套图数组"
    },
    "AIBusinessKeyImgRespVO": {
      "type": "object",
      "properties": {
        "imgId": {
          "type": "integer",
          "description": "AI生成图片id",
          "format": "int32",
          "example": 1
        },
        "createTime": {
          "type": "string",
          "description": "时间",
          "format": "date-time"
        },
        "list": {
          "type": "array",
          "description": "三套图数组",
          "items": {
            "$ref": "#/components/schemas/AiImgResultRespVO"
          }
        },
        "name": {
          "type": "string",
          "description": "批次名称",
          "example": "批次1"
        }
      },
      "description": "管理后台 - AI生成结果与历史 Response VO"
    }
  }
}
